# 서버 전용 비밀 값. 실제 값은 server/.env.local 에 두고 커밋하지 않는다.
# 비워 두면 해당 Provider는 Mock으로 동작한다. (실제 구현은 미검증)

# ParkingDataProvider: Supabase (둘 다 있어야 선택)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# LiveProvider: 부산시설공단 실시간 주차 API (둘 다 있어야 선택)
BUSAN_LIVE_API_URL=
BUSAN_LIVE_API_KEY=

# GeoProvider: 카카오 로컬 REST
KAKAO_REST_API_KEY=

# AIProvider: OpenAI (둘 다 있어야 선택, 모델 ID는 검증 후 지정)
OPENAI_API_KEY=
OPENAI_MODEL=

# 배포 시 앱 출처만 허용. 비우면 '*'
CORS_ORIGIN=

# 1 이면 Mock 실시간 조회 실패를 흉내 낸다(FR-017 시연)
MOCK_LIVE_FAIL=
