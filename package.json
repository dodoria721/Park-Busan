{
  "name": "parkbusan",
  "private": true,
  "workspaces": [
    "shared",
    "server",
    "mobile"
  ],
  "scripts": {
    "dev:server": "npm run dev -w server",
    "dev:app": "npm run web -w mobile",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test -w shared && npm test -w server && npm test -w mobile",
    "lint": "npm run lint --workspaces --if-present",
    "doctor": "cd mobile && npx expo-doctor",
    "test:api": "powershell -ExecutionPolicy Bypass -File scripts/test-api.ps1",
    "sync:locations": "node scripts/sync-parking-locations.mjs"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
